{
  "name": "Pro Micro nRF52840 (SuperMini)",
  "vendor": "SuperMini",
  "url": "https://docs.zephyrproject.org/latest/boards/others/promicro_nrf52840/doc/index.html",
  "frameworks": ["arduino"],
  "build": {
    "arduino": {"ldscript": "nrf52840_s140_v6.ld"},
    "bsp": {"name": "adafruit"},
    "core": "nRF5",
    "cpu": "cortex-m4",
    "extra_flags": "-DNRF52840_XXAA",
    "f_cpu": "64000000L",
    "hwids": [["0x239A", "0x00B3"]],
    "mcu": "nrf52840",
    "usb_product": "Pro Micro nRF52840",
    "variant": "promicro_nrf52840",
    "softdevice": {"sd_flags": "-DS140", "sd_name": "s140", "sd_version": "6.1.1", "sd_fwid": "0x00B6"},
    "bootloader": {"settings_addr": "0xFF000"}
  },
  "upload": {
    "maximum_ram_size": 248832,
    "maximum_size": 815104,
    "protocol": "nrfutil",
    "protocols": ["nrfutil"],
    "speed": 115200,
    "require_upload_port": true,
    "use_1200bps_touch": true,
    "wait_for_upload_port": true
  }
}

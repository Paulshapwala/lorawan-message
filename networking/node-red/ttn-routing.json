  {
    "id": "eeab84a8de625e0c",
    "type": "function",
    "z": "7880a935fa2e187c",
    "name": "Track communications",
    "func": "/**\n * Build a dashboard snapshot from MQTT connection status, routed HTTP\n * requests and responses, and TTN uplink and downlink events.\n * Node context keeps the latest device readings and up to 100 messages.\n * Status rank prevents an earlier stage from replacing a later one.\n */\nconst state = context.get(\"communications\") || {\n    connectivity: \"connecting\",\n    devices: {},\n    messages: []\n};\nconst statuses = {\n    queued: [\"queued\", 1],\n    sent: [\"sent\", 2],\n    ack: [\"acknowledged\", 3],\n    nack: [\"unacknowledged\", 3],\n    failed: [\"failed\", 3]\n};\nconst now = new Date().toISOString();\n\nif (msg.status) {\n    const text = String(msg.status.text || \"\").split(\".\").pop();\n    state.connectivity = text === \"connected\" ? \"connected\" :\n        (text === \"connecting\" || !text ? \"connecting\" : \"disconnected\");\n} else if (msg.route) {\n    let record = state.messages.find(item => item.id === msg.route.id);\n    if (record) {\n        record.from = msg.route.from;\n        record.to = msg.route.to;\n        record.message = msg.route.message;\n        record.createdAt = msg.route.createdAt;\n    } else {\n        record = { ...msg.route, status: \"forwarding\", rank: 0, updatedAt: now };\n        state.messages.unshift(record);\n    }\n    if (msg.statusCode != null && record.rank === 0) {\n        const code = msg.statusCode;\n        record.updatedAt = now;\n        if (Number.isInteger(code) && code >= 200 && code < 300) {\n            record.status = \"queued\";\n            record.rank = 1;\n            record.queuedAt = now;\n            delete record.error;\n        } else {\n            record.status = \"failed\";\n            record.error = code === 404 ? \"TTN could not find this end device.\" :\n                (code === 401 || code === 403 ? \"TTN refused permission to queue this message.\" :\n                    (Number.isInteger(code) && code < 500 ? \"TTN rejected the queue request (HTTP \" + code + \").\" :\n                        \"TTN did not confirm the queue request.\"));\n        }\n    }\n} else {\n    const path = /^v3\\/your-ttn-app@ttn\\/devices\\/(custom-([1-9][0-9]{0,2}))\\/(up|down\\/([a-z]+))$/.exec(msg.topic || \"\");\n    const event = msg.payload;\n    if (msg.retain || !path || Number(path[2]) > 255 || !event || event.end_device_ids?.device_id !== path[1]) {\n        return null;\n    }\n\n    state.connectivity = \"connected\";\n    const device = path[1];\n    const type = path[4];\n    if (path[3] === \"up\" && event.uplink_message) {\n        const uplink = event.uplink_message;\n        const receivedAt = event.received_at || uplink.received_at || now;\n        if (receivedAt < (state.devices[device]?.receivedAt || \"\")) {\n            return null;\n        }\n        const radio = (uplink.rx_metadata || []).find(item =>\n            Number.isFinite(item.rssi) || Number.isFinite(item.snr)) || {};\n        state.devices[device] = {\n            receivedAt,\n            frame: uplink.f_cnt ?? 0,\n            rssi: radio.rssi ?? null,\n            snr: radio.snr ?? null\n        };\n    } else if (Object.prototype.hasOwnProperty.call(statuses, type)) {\n        const details = event[\"downlink_\" + type];\n        const downlink = details?.downlink || details || {};\n        const ids = [...(event.correlation_ids || []), ...(downlink.correlation_ids || [])];\n        const frame = downlink.f_cnt ?? null;\n        const bytes = typeof downlink.frm_payload === \"string\" ? downlink.frm_payload : null;\n        // Match by correlation ID first, then fall back to frame or payload when possible.\n        const routeId = ids.find(id => typeof id === \"string\" && id.startsWith(\"mesh:route:\"));\n        const deliveryId = ids.find(id => typeof id === \"string\" && id.startsWith(\"as:downlink:\"));\n        const id = routeId || deliveryId || (frame === null ? null : \"ttn:\" + device + \":\" + frame);\n        let record = state.messages.find(item =>\n            (id && item.id === id) || (deliveryId && item.deliveryId === deliveryId));\n        if (!record && frame !== null) {\n            record = state.messages.find(item => item.to === device && item.frame === frame &&\n                (!routeId || !item.from));\n        }\n        if (!record && !routeId && bytes) {\n            const pending = state.messages.filter(item => item.to === device && item.encoded === bytes &&\n                item.rank < 2 && (!item.deliveryId || item.deliveryId === deliveryId));\n            if (pending.length === 1) record = pending[0];\n        }\n        if (!record && !id && !bytes) return null;\n\n        if (!record) {\n            record = { id: id || msg._msgid, from: null, to: device, createdAt: now, rank: 0 };\n            state.messages.unshift(record);\n        }\n        if (routeId && !record.from) record.id = routeId;\n        if (deliveryId) record.deliveryId = deliveryId;\n        if (frame !== null) record.frame = frame;\n        if (bytes) {\n            record.encoded = bytes;\n            if (record.message == null) record.message = Buffer.from(bytes, \"base64\").toString(\"utf8\");\n        }\n        const [status, rank] = statuses[type];\n        if (rank >= record.rank) {\n            const timestamp = event.received_at || now;\n            if (rank > record.rank && !record[status + \"At\"]) {\n                record[status + \"At\"] = timestamp;\n            }\n            record.status = status;\n            delete record.error;\n            record.rank = rank;\n            record.updatedAt = timestamp;\n        }\n    } else {\n        return null;\n    }\n}\n\nstate.messages = state.messages.slice(0, 100);\ncontext.set(\"communications\", state);\nreturn { payload: {\n    connectivity: state.connectivity,\n    devices: state.devices,\n    messages: state.messages.map(({ id, from, to, message, status, error, createdAt, updatedAt, queuedAt, sentAt }) =>\n        ({ id, from, to, message, status, error, createdAt, updatedAt, queuedAt, sentAt }))\n} };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 457,
    "y": 248,
    "wires": [
      [
        "ac36dcd9def0231c"
      ]
    ]

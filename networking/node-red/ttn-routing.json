  {
    "id": "ac36dcd9def0231c",
    "type": "ui-template",
    "z": "7880a935fa2e187c",
    "group": "fa5566fd216aa6f8",
    "page": "",
    "ui": "",
    "name": "Communications dashboard",
    "order": 1,
    "width": 0,
    "height": 0,
    "head": "",
    "format": "<template>\n  <main class=\"mesh-console\">\n    <header class=\"mesh-header\">\n      <div class=\"mesh-identity\">\n        <span class=\"mesh-radio\" aria-hidden=\"true\"><i class=\"mdi mdi-radio-tower\"></i></span>\n        <div>\n          <h1>LoRa Communications</h1>\n          <p>your-ttn-app <span>·</span> TTN EU1</p>\n        </div>\n      </div>\n      <div class=\"mesh-connection\" :class=\"dashboard.connectivity\" role=\"status\">\n        <span></span>{{ connectionLabel }}\n      </div>\n    </header>\n\n    <section class=\"mesh-overview\" aria-label=\"Message totals\">\n      <article class=\"mesh-stat waiting\">\n        <i class=\"mdi mdi-clock-outline\" aria-hidden=\"true\"></i>\n        <div><p>Awaiting poll</p><strong>{{ totals.queued }}</strong></div>\n      </article>\n      <article class=\"mesh-stat sent\">\n        <i class=\"mdi mdi-check\" aria-hidden=\"true\"></i>\n        <div><p>Sent by gateway</p><strong>{{ totals.sent }}</strong></div>\n      </article>\n      <article class=\"mesh-stat failed\">\n        <i class=\"mdi mdi-alert-circle-outline\" aria-hidden=\"true\"></i>\n        <div><p>Failed</p><strong>{{ totals.failed }}</strong></div>\n      </article>\n    </section>\n\n    <div class=\"mesh-workspace\">\n      <section class=\"mesh-panel mesh-traffic\" aria-labelledby=\"traffic-title\">\n        <header class=\"mesh-panel-header\">\n          <div>\n            <h2 id=\"traffic-title\">Message activity</h2>\n            <p>{{ filtered.length }} of {{ dashboard.messages.length }} recent messages</p>\n          </div>\n          <label>\n            <span class=\"mesh-sr\">Filter by delivery status</span>\n            <select v-model=\"filter\">\n              <option value=\"all\">All statuses</option>\n              <option value=\"forwarding\">Forwarding</option>\n              <option value=\"queued\">Awaiting poll</option>\n              <option value=\"sent\">Sent by gateway</option>\n              <option value=\"failed\">Failed</option>\n            </select>\n          </label>\n        </header>\n\n        <div v-if=\"!filtered.length\" class=\"mesh-empty\">\n          <span><i class=\"mdi mdi-message-outline\" aria-hidden=\"true\"></i></span>\n          <h3>{{ dashboard.messages.length ? 'No matching messages' : 'No messages yet' }}</h3>\n          <p v-if=\"!dashboard.messages.length\">\n            Send from a device, then choose <b>Check messages</b> on its destination.\n          </p>\n          <button v-else type=\"button\" @click=\"filter = 'all'\">Clear filter</button>\n        </div>\n\n        <div v-else class=\"mesh-table-wrap\">\n          <table>\n            <thead><tr><th>Message</th><th>Route</th><th>Status</th><th>Time</th></tr></thead>\n            <tbody>\n              <tr v-for=\"item in filtered\" :key=\"item.id\" :class=\"{ selected: selected?.id === item.id }\">\n                <td><button class=\"mesh-message\" type=\"button\" @click=\"selectedId = item.id\">{{ item.message || 'Downlink' }}</button></td>\n                <td class=\"mesh-route\">{{ item.from || 'TTN' }} <span aria-hidden=\"true\">→</span> {{ item.to }}</td>\n                <td><span class=\"mesh-status\" :class=\"bucket(item.status)\">{{ statusLabel(item.status) }}</span></td>\n                <td class=\"mesh-time\"><time :datetime=\"item.updatedAt\">{{ formatTime(item.updatedAt) }}</time></td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <aside class=\"mesh-sidebar\" aria-label=\"Device and message details\">\n        <section class=\"mesh-panel mesh-devices\" aria-labelledby=\"devices-title\">\n          <header class=\"mesh-panel-header\"><div><h2 id=\"devices-title\">Devices</h2><p>Last uplink heard by the gateway</p></div></header>\n          <div class=\"mesh-device\" v-for=\"device in deviceList\" :key=\"device.id\">\n            <span class=\"mesh-device-icon\" aria-hidden=\"true\"><i class=\"mdi mdi-radio-tower\"></i></span>\n            <div>\n              <h3>{{ device.id }}</h3>\n              <p>{{ device.info ? 'Last heard ' + formatTime(device.info.receivedAt) : 'Waiting for an uplink' }}</p>\n              <p class=\"mesh-signal\" v-if=\"device.info && (device.info.rssi != null || device.info.snr != null)\">\n                <span v-if=\"device.info.rssi != null\">{{ device.info.rssi }} dBm RSSI</span>\n                <span v-if=\"device.info.snr != null\">{{ device.info.snr }} dB SNR</span>\n              </p>\n            </div>\n          </div>\n        </section>\n\n        <section class=\"mesh-panel mesh-detail\" v-if=\"selected\" aria-labelledby=\"message-title\">\n          <header class=\"mesh-panel-header\"><div><h2 id=\"message-title\">Selected message</h2></div></header>\n          <div class=\"mesh-detail-body\">\n            <p class=\"mesh-full-message\">{{ selected.message || 'Downlink' }}</p>\n            <dl>\n              <div><dt>From</dt><dd>{{ selected.from || 'TTN' }}</dd></div>\n              <div><dt>To</dt><dd>{{ selected.to }}</dd></div>\n              <div v-if=\"selected.queuedAt\"><dt>Queued</dt><dd>{{ formatTime(selected.queuedAt) }}</dd></div>\n              <div v-if=\"selected.sentAt\"><dt>Sent</dt><dd>{{ formatTime(selected.sentAt) }}</dd></div>\n            </dl>\n            <p class=\"mesh-detail-note\">{{ detailLabel }}</p>\n          </div>\n        </section>\n      </aside>\n    </div>\n  </main>\n</template>\n\n<script>\n/**\n * FlowFuse component for viewing device activity and recent downlinks.\n * Computed properties prepare the snapshot for filtering and display.\n */\nexport default {\n  /** Set the default filter and leave the selected message unset. */\n  data() {\n    return { filter: 'all', selectedId: null };\n  },\n  computed: {\n    /** Return the latest tracker snapshot or a placeholder while connecting. */\n    dashboard() {\n      return this.msg?.payload || { connectivity: 'connecting', devices: {}, messages: [] };\n    },\n    /** Convert the MQTT connection state into text for the dashboard header. */\n    connectionLabel() {\n      return { connected: 'TTN connected', connecting: 'Connecting to TTN', disconnected: 'TTN disconnected' }[this.dashboard.connectivity] || 'TTN status unavailable';\n    },\n    /** Count the messages shown in the queued, sent, and failed groups. */\n    totals() {\n      const counts = { queued: 0, sent: 0, failed: 0 };\n      for (const item of this.dashboard.messages) {\n        const key = this.bucket(item.status);\n        if (key in counts) counts[key]++;\n      }\n      return counts;\n    },\n    /** Return messages in the selected status group or all messages. */\n    filtered() {\n      return this.dashboard.messages.filter(item => this.filter === 'all' || this.bucket(item.status) === this.filter);\n    },\n    /** Return the selected visible message, falling back to the first match. */\n    selected() {\n      return this.filtered.find(item => item.id === this.selectedId) || this.filtered[0] || null;\n    },\n    /** Combine known devices and message endpoints, then sort them by numeric suffix. */\n    deviceList() {\n      const ids = new Set(['custom-1', 'custom-2', ...Object.keys(this.dashboard.devices)]);\n      for (const item of this.dashboard.messages) {\n        if (item.from) ids.add(item.from);\n        if (item.to && (!item.error || this.dashboard.devices[item.to])) ids.add(item.to);\n      }\n      return [...ids].sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))\n        .map(id => ({ id, info: this.dashboard.devices[id] }));\n    },\n    /** Show the selected message's error or explain its current delivery stage. */\n    detailLabel() {\n      if (this.selected?.error) return this.selected.error;\n      return {\n        forwarding: 'Waiting for TTN to accept this message.',\n        queued: 'TTN is waiting for ' + this.selected?.to + ' to poll.',\n        sent: 'The gateway reported transmission. Check the receiver’s OLED for delivery.',\n        acknowledged: 'The receiver acknowledged delivery.',\n        unacknowledged: 'TTN reported that an acknowledgement was missing.',\n        failed: 'TTN reported a downlink failure.'\n      }[this.selected?.status];\n    }\n  },\n  methods: {\n    /** Group detailed delivery statuses into the dashboard's filter categories. */\n    bucket(status) {\n      return { queued: 'queued', sent: 'sent', acknowledged: 'sent', failed: 'failed', unacknowledged: 'failed' }[status] || 'forwarding';\n    },\n    /** Convert a message status into a readable label. */\n    statusLabel(status) {\n      return { forwarding: 'Forwarding', queued: 'Queued', sent: 'Sent', acknowledged: 'Acknowledged', unacknowledged: 'Unacknowledged', failed: 'Failed' }[status] || 'Unknown';\n    },\n    /** Format a valid timestamp in the browser's local time, or show a dash. */\n    formatTime(timestamp) {\n      const parsed = new Date(timestamp);\n      return timestamp && Number.isFinite(parsed.getTime()) ?\n        new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(parsed) : '—';\n    }\n  }\n};\n</script>\n\n<style>\n.mesh-console {\n  --mesh-page: #0c1420;\n  --mesh-panel: #121e2d;\n  --mesh-line: #2a394c;\n  --mesh-ink: #f0f5fc;\n  --mesh-muted: #9faec2;\n  --mesh-blue: #86bcff;\n  --mesh-green: #6ee0ad;\n  --mesh-amber: #f8c77a;\n  --mesh-red: #ffa3aa;\n  margin: 0 auto;\n  width: min(100%, 1350px);\n  padding: clamp(18px, 4vw, 52px);\n  background: var(--mesh-page);\n  color: var(--mesh-ink);\n  font: 400 14px/1.5 Inter, Roboto, system-ui, sans-serif;\n}\n\n.mesh-console h1, .mesh-console h2, .mesh-console h3, .mesh-console p { margin: 0; }\n.mesh-console h1 { font-size: clamp(22px, 3.4vw, 37px); line-height: 1.14; letter-spacing: -.038em; font-weight: 720; }\n.mesh-console h2 { font-size: 17px; font-weight: 690; letter-spacing: -.02em; }\n.mesh-console h3 { font-size: 14px; font-weight: 650; }\n.mesh-console p { color: var(--mesh-muted); }\n.mesh-console button, .mesh-console select { font: inherit; }\n.mesh-console button:focus-visible, .mesh-console select:focus-visible { outline: 2px solid var(--mesh-blue); outline-offset: 2px; }\n.mesh-header, .mesh-identity, .mesh-panel-header { display: flex; align-items: center; justify-content: space-between; }\n.mesh-header { gap: 16px; margin-bottom: 28px; }\n.mesh-identity { justify-content: flex-start; gap: 15px; }\n.mesh-identity p { margin-top: 6px; font-size: 13px; }\n.mesh-identity p span { margin: 0 4px; }\n.mesh-radio, .mesh-device-icon { display: grid; place-items: center; color: var(--mesh-blue); background: #1a3049; border: 1px solid #315378; }\n.mesh-radio { width: 51px; height: 51px; border-radius: 13px; flex: 0 0 auto; font-size: 27px; }\n.mesh-connection { display: flex; gap: 8px; align-items: center; white-space: nowrap; border-radius: 999px; padding: 7px 13px; border: 1px solid var(--mesh-line); color: var(--mesh-muted); font-size: 12px; font-weight: 620; }\n.mesh-connection > span { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }\n.mesh-connection.connected { color: var(--mesh-green); border-color: #2b554a; background: #142b2a; }\n.mesh-connection.disconnected { color: var(--mesh-red); }\n.mesh-overview { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-bottom: 18px; }\n.mesh-stat, .mesh-panel { background: var(--mesh-panel); border: 1px solid var(--mesh-line); border-radius: 13px; }\n.mesh-stat { display: flex; align-items: flex-start; gap: 13px; min-height: 100px; padding: 17px 19px; }\n.mesh-stat i { display: grid; place-items: center; width: 33px; height: 33px; border-radius: 9px; background: #253144; font-size: 19px; }\n.mesh-stat.waiting i { color: var(--mesh-amber); background: #3a3026; }\n.mesh-stat.sent i { color: var(--mesh-green); background: #1e3738; }\n.mesh-stat.failed i { color: var(--mesh-red); background: 
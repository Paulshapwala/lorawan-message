  {
    "id": "5a7b61c9fe0a0201",
    "type": "function",
    "z": "7880a935fa2e187c",
    "name": "Route by destination tag",
    "func": "/**\n * Convert a live TTN FPort 2 uplink into a downlink queue request.\n * The first byte selects the recipient. The following bytes are forwarded as\n * the FPort 1 payload. Rejected uplinks return null. A correlation ID lets\n * the tracker match the HTTP response and later MQTT events.\n */\nconst application = \"your-ttn-app\";\nconst event = msg.payload;\nconst source = event?.end_device_ids;\nconst from = source?.device_id;\nconst uplink = event?.uplink_message;\nconst sourceNumber = /^custom-([1-9][0-9]{0,2})$/.exec(from || \"\");\nconst uplinkTopic = \"v3/\" + application + \"@ttn/devices/\" + from + \"/up\";\n\nif (msg.retain || !sourceNumber || Number(sourceNumber[1]) > 255 ||\n    source.application_ids?.application_id !== application ||\n    msg.topic !== uplinkTopic || uplink?.f_port !== 2) {\n    return null;\n}\n\nconst encoded = uplink.frm_payload;\nconst bytes = typeof encoded === \"string\" ? Buffer.from(encoded, \"base64\") : Buffer.alloc(0);\nif (bytes.length < 2 || bytes.toString(\"base64\") !== encoded || bytes[0] === 0) {\n    node.warn(\"Expected a nonzero destination byte followed by message data.\");\n    return null;\n}\n\nconst to = \"custom-\" + bytes[0];\nconst message = bytes.subarray(1);\nconst encodedMessage = message.toString(\"base64\");\nconst routeId = \"mesh:route:\" + msg._msgid;\nreturn {\n    url: \"https://eu1.cloud.thethings.network/api/v3/as/applications/\" + application + \"/devices/\" + to + \"/down/push\",\n    followRedirects: false,\n    requestTimeout: 7000,\n    payload: {\n        downlinks: [{\n            f_port: 1,\n            frm_payload: encodedMessage,\n            confirmed: false,\n            priority: \"NORMAL\",\n            correlation_ids: [routeId]\n        }]\n    },\n    route: {\n        id: routeId,\n        from,\n        to,\n        message: message.toString(\"utf8\"),\n        encoded: encodedMessage,\n        createdAt: event.received_at || uplink.received_at || new Date().toISOString()\n    }\n};\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 426,
    "y": 100,
    "wires": [
      [
        "eeab84a8de625e0c",
        "af345ce49f703fc5"
      ]
    ]
  },
